# Upstream Fabric, pinned to v57.0.0. Has its own git history and is
# reproducible via the clone command in SANDBOX-SETUP.md.
fabric/

# Terraform working files
.terraform/
*.tfstate
*.tfstate.*
crash.log
tfplan.out
destroy.tfplan
*.tfplan

# Generated by stage 0 - contains bucket names and service account emails.
# Regenerated on every apply; the source of truth is the dataset YAML.
*-providers.tf

# Never commit real credentials
*.json.key
service-account*.json
